# Waveshare ESP32-P4-WIFI6-Touch-LCD-3.4C, same chip/board settings as the clock
# firmware (../../sdkconfig.defaults).
CONFIG_IDF_TARGET="esp32p4"
# CONFIG_ESP32P4_SELECTS_REV_LESS_V3 is not set
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="32MB"
CONFIG_FREERTOS_HZ=1000

# ESP-Hosted link to the on-board ESP32-C6 over SDIO
CONFIG_ESP_WIFI_REMOTE_ENABLED=y
CONFIG_ESP_WIFI_REMOTE_LIBRARY_HOSTED=y
CONFIG_ESP_HOSTED_ENABLED=y
CONFIG_SLAVE_IDF_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_CP_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD=y
CONFIG_ESP_HOSTED_SDIO_HOST_INTERFACE=y
# If the transfer fails half way, try a slower bus first:
# CONFIG_ESP_HOSTED_SDIO_CLOCK_FREQ_KHZ=10000

# Partition table that keeps the clock's NVS intact (see partitions.csv)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# Read the C6 image from LittleFS (components/ota_littlefs/slave_fw_bin/*.bin)
CONFIG_OTA_METHOD_LITTLEFS=y
CONFIG_OTA_DELETE_FILE_AFTER_FLASH=y
CONFIG_OTA_VERSION_CHECK_HOST_SLAVE=y
CONFIG_OTA_VERSION_CHECK_SLAVEFW_SLAVE=y
